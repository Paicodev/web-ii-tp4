# Puerto donde escucha el servidor único (HTML, WebSocket y SSE)
PORT=3000

# Interfaz de red (0.0.0.0 permite acceso local y desde la misma red)
HOST=0.0.0.0

# URL base del catálogo externo (DummyJSON)
CATALOG_BASE_URL=https://dummyjson.com

# Tiempo máximo de espera por cada consulta al catálogo (en milisegundos)
CATALOG_TIMEOUT_MS=5000

# Demora artificial enviada a DummyJSON (?delay=ms) para probar catálogo lento sin tocar código
CATALOG_DELAY_MS=0

# Intervalo de heartbeat ping/pong para detectar conexiones WebSocket muertas (en milisegundos)
WS_HEARTBEAT_MS=30000
